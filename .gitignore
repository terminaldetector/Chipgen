# Built chip cores — regenerate with `python3 python/build_cores.py`
core/*.so
core/*.dylib
core/*.dll
core/*.o

# Rendered audio / exported tracks
output/
*.pyc
__pycache__/

# Bridge archives built by bridge/make_zip.py
dist/

# Measurements for imported banks, keyed by patch fingerprint. Generated
# per user and unbounded in size — a corpus-sized bank adds hundreds of
# entries. bank_audition.json IS committed: that one is the built-in
# bank's shipped measurements, which are the same for everybody.
python/imported_audition.json

# Stamped by tests/run_tests.py on a full run so studio.health() can
# report the count without re-running the suite. Per-run, so tracking it
# would make every test run a diff. Absent is reported honestly as None.
tests/last_run.json

# The contract, dumped for the static page. Generated by
# `python3 python/serve.py --dump studio/studio.json`, and baked into the
# deploy bundle at build time — tracking it would mean a diff every time
# the engine gains a directive.
studio/studio.json
