; forge_demo — instruments made by the synthesis layer, on all three chips.
;
;   python3 python/chipgen.py examples/forge_demo.trk -o forge_demo.mp3 \
;       --forge-bank python/synthesis/banks/starter.bank.json
;
; Every instrument name below is in the starter bank (forge.py show). The
; ones with a detune layer take the next channel up (fm2 -> fm3, fm4 -> fm5,
; opl0 -> opl1, pulse1 -> pulse2); the score leaves those channels free.
; The NES parts are macros played by a frame driver: `inst nes3` is changed
; between rows to turn one noise channel into a kick, a snare and a hat.

title Forge demo
author chipgen
notes YM2612 + OPL2 + 2A03 with instruments made by forge.py

ticks 240
bpm 118
lpb 4

inst fm0 fm_punch_bass
inst fm2 fm_saw_lead
inst fm4 fm_pad
inst opl0 opl_pad
inst nes0 nes_square_lead
inst nes2 nes_sub_bass

; the NES is the quietest of the three chips in the engine's own mix, and a
; pulse cannot be turned up past 127, so the others come down to meet it
vol fm0 80
vol fm2 70
vol fm4 70
vol opl0 45

cols fm0 fm2 fm4 opl0 nes0 nes2 nes3
; bar 1: A
inst nes3 nes_noise_kick
A-2  A-4  C-3  E-3  E-5  A-2  6
...  ...  ...  ...  ...  ...  ...
inst nes3 nes_noise_hat
...  C-4  ...  ...  ...  ...  6
A-2  ...  ...  ...  ...  ...  ...
inst nes3 nes_noise_snare
...  E-4  ...  ...  C-5  ...  6
...  ...  ...  ...  ...  ...  ...
inst nes3 nes_noise_hat
A-2  A-5  ...  ...  ...  ...  6
...  ...  ...  ...  ...  ...  ...
