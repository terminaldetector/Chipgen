title Echo etude
tempo 125
channels 4
author schism-chipgen (synthetic)
msg The echo is in the instrument's envelopes (a technique
msg studied in Skaven's Fourth Symmetriad, with our own numbers).
inst 1 name=Echo wave=saw oct=3-6 cutoff=100 res=8 penv=0:0,11:0,12:16,23:16,24:-16,47:-14 fenv=0:44,11:8,12:36,23:7,24:30,40:5 venv=0:64,4:16,11:0,12:34,17:10,23:0,24:22,27:7,36:0 nna=off
inst 2 name=Bass wave=triangle oct=1-4 nna=cut vol=64 venv=0:64,30:44s,40:44s,60:0 fade=60
smp thump wave=kick
smp tick wave=rim
smp tss wave=hat
inst 3 name=Kit kit=C-2:thump,D-2:tick,F#2:tss
inst 4 name=Pad wave=pad voices=5 detune=10 secs=3 base=C-4 oct=3-4 nna=fade fade=20 vol=34 venv=0:0,60:64,200:64s,240:64s
